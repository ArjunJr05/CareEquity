# ==========================================
# CareEquity SDOH Assistant Configuration
# ==========================================

# 1. Multi-Provider LLM API Keys (Free Tiers Supported)
# Primary: NVIDIA NIM (Llama 3.1 8B)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Secondary: Groq (Ultra-fast compound-mini or llama-3.3-70b)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Backup: OpenRouter (Free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 2. Performance & Concurrency
REQUEST_TIMEOUT=4
MAX_WORKERS=4
TEMPERATURE=0.2
MAX_TOKENS=1024

# 3. Backend Service Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000